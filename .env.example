# Database: SQLite locale oppure postgresql+psycopg://user:pass@host/dbname
DATABASE_URL=sqlite:///./prontoagente.db
APP_ENV=development
LOG_LEVEL=INFO

# /v1 è sempre visibile in development/test; in production serve questo opt-in.
ENABLE_LEGACY_V1=false

# Showcase offline soltanto: ignorato (fail-closed) quando APP_ENV=production.
ENABLE_DEMO_CONNECTORS=false

# Obbligatorio e segreto in production; ruotarlo invalida tutte le API key esistenti.
API_KEY_PEPPER=dev-only-change-me

# Outbox/HTTP
HTTP_TIMEOUT_SECONDS=10
OUTBOX_LEASE_SECONDS=30
OUTBOX_MAX_ATTEMPTS=3

# Microsoft Graph: il connector resta disabilitato se manca anche un solo valore.
M365_CONNECTOR_ENABLED=false
# ID interno del solo tenant ProntoAgente autorizzato a usare questa configurazione.
M365_PLATFORM_TENANT_ID=
# Impostare esattamente Mail.ReadBasic.All solo dopo la verifica in Entra;
# il token Graph viene trattato come opaque.
M365_PERMISSION_ATTESTATION=
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_MAILBOX_ID=
M365_FOLDER_ID=

# Milestone 3: preparazione AI asincrona. Tutti i gate sono false per default.
AI_PREPARATION_ENABLED=false
AI_NETWORK_ENABLED=false
# Identificatore non segreto e chiave AES-256 base64 (es.: openssl rand -base64 32).
AI_ENCRYPTION_KEY_ID=
AI_ENCRYPTION_KEY=
AI_WORKER_LEASE_SECONDS=60

# Adapter OpenAI Responses-compatible, opzionale e deployment-controlled.
AI_OPENAI_RESPONSES_URL=
AI_OPENAI_API_KEY=
AI_OPENAI_ALLOWED_HOSTS=api.openai.com
AI_OPENAI_ALLOWED_MODELS=
AI_HTTP_TIMEOUT_SECONDS=20
AI_MAX_RESPONSE_BYTES=262144

# Hard cap di deployment; la policy tenant può solo restringerli.
AI_HARD_MAX_INPUT_TOKENS=4096
AI_HARD_MAX_OUTPUT_TOKENS=1024
AI_HARD_MAX_RUN_MICROUSD=100000
AI_HARD_DAILY_INPUT_TOKENS=1000000
AI_HARD_DAILY_OUTPUT_TOKENS=250000
AI_HARD_DAILY_MICROUSD=1000000

# Snapshot prezzi operativi in micro-USD per milione di token (non billing).
AI_FAKE_INPUT_MICROUSD_PER_MILLION=0
AI_FAKE_OUTPUT_MICROUSD_PER_MILLION=0
AI_OPENAI_INPUT_MICROUSD_PER_MILLION=
AI_OPENAI_OUTPUT_MICROUSD_PER_MILLION=
